# Doxygen configuration for the CPDN controller repository.
# Generated into the build tree by CMake.

PROJECT_NAME           = "CPDN Controller"
PROJECT_BRIEF          = "BOINC task controller for climateprediction.net models"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/doxygen"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"
SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 2
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO
CPP_CLI_SUPPORT        = NO

USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/README.md"

INPUT                  = "@CMAKE_SOURCE_DIR@/README.md" \
                         "@CMAKE_SOURCE_DIR@/docs" \
                         "@CMAKE_SOURCE_DIR@/src" \
                         "@CMAKE_SOURCE_DIR@/lib" \
                         "@CMAKE_SOURCE_DIR@/api" \
                         "@CMAKE_SOURCE_DIR@/models"
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.c \
                         *.cpp \
                         *.md
RECURSIVE              = YES

EXCLUDE                = "@CMAKE_SOURCE_DIR@/build" \
                         "@CMAKE_SOURCE_DIR@/third_party" \
                         "@CMAKE_SOURCE_DIR@/vcpkg" \
                         "@CMAKE_SOURCE_DIR@/tests/unit" \
                         "@CMAKE_SOURCE_DIR@/old_src" \
                         "@CMAKE_SOURCE_DIR@/zip/ZipLib/extlibs"
EXCLUDE_PATTERNS       = */build/* \
                         */third_party/* \
                         */vcpkg/* \
                         */tests/unit/* \
                         */old_src/* \
                         */zip/ZipLib/extlibs/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@CMAKE_BINARY_DIR@/doxygen/doxygen_warnings.log"

HAVE_DOT               = @CPDN_DOXYGEN_HAVE_DOT@
DOT_PATH               = "@CPDN_DOT_EXECUTABLE@"
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
UML_LIMIT_NUM_FIELDS   = 20
DOT_UML_DETAILS        = NO
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 80
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES
